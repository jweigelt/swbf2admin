{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x86-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "x86-Debug",
      "displayName": "x86 Debug",
      "inherits": "x86-base",
      "binaryDir": "${sourceDir}/out/build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x86-Release",
      "displayName": "x86 Release",
      "inherits": "x86-base",
      "binaryDir": "${sourceDir}/out/build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86-Debug",
      "displayName": "Build x86 Debug",
      "configurePreset": "x86-Debug"
    },
    {
      "name": "x86-Release",
      "displayName": "Build x86 Release",
      "configurePreset": "x86-Release"
    }
  ]
}
