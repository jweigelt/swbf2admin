{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "x64-Debug",
      "displayName": "x64 Debug",
      "inherits": "x64-base",
      "binaryDir": "${sourceDir}/out/build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "x64 Release",
      "inherits": "x64-base",
      "binaryDir": "${sourceDir}/out/build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-Debug",
      "displayName": "Build x64 Debug",
      "configurePreset": "x64-Debug"
    },
    {
      "name": "x64-Release",
      "displayName": "Build x64 Release",
      "configurePreset": "x64-Release"
    }
  ]
}
