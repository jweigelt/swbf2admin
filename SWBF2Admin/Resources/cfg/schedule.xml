<?xml version="1.0" encoding="utf-8"?>
<ScheduleConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--automatically restart the server once it has been running for a given amount of time-->
  <EnableScheduledRestart>false</EnableScheduledRestart>
  <!--time (in minutes) the server has to be running before it is restarted-->
  <RestartThresholdMinutes>360</RestartThresholdMinutes>
  <!--broadcast a message in-game before the scheduled restart-->
  <EnableRestartAnnouncement>true</EnableRestartAnnouncement>
  <!--message template; use {minutes} or {seconds} for the remaining time-->
  <RestartAnnouncement>The server will restart in {minutes} minute(s).</RestartAnnouncement>
  <!--number of minutes before the restart to begin announcements-->
  <RestartCountdownMinutes>15</RestartCountdownMinutes>
  <!--time (in seconds) between restart announcements-->
  <AnnouncementInterval>300</AnnouncementInterval>
</ScheduleConfiguration>
