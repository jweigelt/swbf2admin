<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\cfg\process_mods.xml" />
    <None Remove="Resources\cfg\process_mods.aspyr.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cfg\core.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cfg\mods.xml" />
    <EmbeddedResource Include="Resources\cfg\mods.aspyr.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cfg\announce.xml" />
    <EmbeddedResource Include="Resources\cfg\game.xml" />
    <EmbeddedResource Include="Resources\cfg\players.xml" />
    <EmbeddedResource Include="Resources\cfg\process_mods.xml" />
    <EmbeddedResource Include="Resources\cfg\process_mods.aspyr.xml" />
    <EmbeddedResource Include="Resources\cfg\schedule.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="MoonSharp" Version="2.0.0.0" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="System.Interactive.Async" Version="7.0.1" />
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyTitle>SWBF2Admin</AssemblyTitle>
    <Description>SWBF2 Server Manager</Description>
    <Company>SWBF2Admin Contributors</Company>
    <Product>SWBF2Admin</Product>
    <Copyright>Copyright ©  2017-2024 Jan Weigelt</Copyright>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>