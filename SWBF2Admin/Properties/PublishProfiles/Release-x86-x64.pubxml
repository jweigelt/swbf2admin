<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>..\build_x86_x64\</PublishDir>
  </PropertyGroup>
  <Target Name="AssembleReleaseFolder" AfterTargets="Publish">
    <PropertyGroup>
      <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)\..'))</RepoRoot>
      <RconServer32Dll Condition="'$(RconServer32Dll)' == ''">$(RepoRoot)rconserver-galaxy\out\RconServer_32.dll</RconServer32Dll>
      <RconServer64Dll Condition="'$(RconServer64Dll)' == ''">$(RepoRoot)..\rconserver-aspyr\out\RconServer_64.dll</RconServer64Dll>
      <ReleaseDir>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</ReleaseDir>
      <ServerDir>$(ReleaseDir)server\</ServerDir>
      <DllLoaderProject>$(RepoRoot)DllLoader\DllLoader.csproj</DllLoaderProject>
      <DllLoader32Out>$(RepoRoot)DllLoader\bin\Release\net10.0\publish\win-x86\</DllLoader32Out>
      <DllLoader64Out>$(RepoRoot)DllLoader\bin\Release\net10.0\publish\win-x64\</DllLoader64Out>
    </PropertyGroup>
    <Message Importance="high" Text="[Release-x86-x64] Assembling release folder at $(ReleaseDir)" />
    <MakeDir Directories="$(ServerSettingsDir)" />
    <Message Importance="high" Text="[Release-x86-x64] Publishing DllLoader (win-x86)..." />
    <Exec Command="dotnet publish &quot;$(DllLoaderProject)&quot; -c Release -r win-x86 --self-contained false -p:PublishSingleFile=true -p:PublishReadyToRun=true -p:DebugType=none -p:DebugSymbols=false -p:PublishProfile= -o &quot;$(DllLoader32Out)&quot;" />
    <Message Importance="high" Text="[Release-x86-x64] Publishing DllLoader (win-x64)..." />
    <Exec Command="dotnet publish &quot;$(DllLoaderProject)&quot; -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -p:PublishReadyToRun=true -p:DebugType=none -p:DebugSymbols=false -p:PublishProfile= -o &quot;$(DllLoader64Out)&quot;" />
    <Copy SourceFiles="$(DllLoader32Out)DllLoader.exe" DestinationFiles="$(ServerDir)DllLoader_32.exe" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(DllLoader64Out)DllLoader.exe" DestinationFiles="$(ServerDir)DllLoader_64.exe" SkipUnchangedFiles="false" />
    <ItemGroup>
      <DebugFilesContent Include="$(RepoRoot)DebugFiles\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DebugFilesContent)" DestinationFiles="@(DebugFilesContent->'$(ReleaseDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <ItemGroup>
      <LicenseFiles Include="$(RepoRoot)licenses\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LicenseFiles)" DestinationFiles="@(LicenseFiles->'$(ReleaseDir)licenses\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(RepoRoot)LICENSE;$(RepoRoot)readme.md" DestinationFolder="$(ReleaseDir)" SkipUnchangedFiles="false" />
    <Copy Condition="Exists('$(RconServer32Dll)')" SourceFiles="$(RconServer32Dll)" DestinationFiles="$(ServerDir)RconServer_32.dll" SkipUnchangedFiles="false" />
    <Copy Condition="Exists('$(RconServer64Dll)')" SourceFiles="$(RconServer64Dll)" DestinationFiles="$(ServerDir)RconServer_64.dll" SkipUnchangedFiles="false" />
    <Warning Condition="!Exists('$(RconServer32Dll)')" Text="[Release-x86-x64] RconServer_32.dll not found at '$(RconServer32Dll)'. Build the rconserver-galaxy CMake project and copy it into server\ manually, or pass -p:RconServer32Dll=&lt;path&gt;." />
    <Warning Condition="!Exists('$(RconServer64Dll)')" Text="[Release-x86-x64] RconServer_64.dll not found at '$(RconServer64Dll)'. Build the rconserver-aspyr CMake project and copy it into server\ manually, or pass -p:RconServer64Dll=&lt;path&gt;." />
    <Message Importance="high" Text="[Release-x86-x64] Release folder assembled successfully: $(ReleaseDir)" />
  </Target>
</Project>
